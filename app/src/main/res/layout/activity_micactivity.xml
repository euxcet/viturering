<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".pages.writing.HandWritingActivity">
    <com.euxcet.viturering.TopBarView
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="#000000"
        app:title="语音输入"/>
    <EditText
        android:id="@+id/input"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/voice_status"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="16dp"
        android:textSize="24sp"
        android:gravity="top"
        android:inputType="text|textMultiLine"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:background="#fff"/>
    <TextView
        android:id="@+id/voice_status"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#F4F4F4"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        app:layout_constraintBottom_toTopOf="@+id/top_bar"
        tools:text="状态"/>
    <Button
        android:id="@+id/open_mic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="打开麦克风"
        app:layout_constraintEnd_toEndOf="@+id/close_mic"
        app:layout_constraintBottom_toTopOf="@+id/close_mic"
        app:layout_constraintTop_toTopOf="@+id/voice_status"/>
    <Button
        android:id="@+id/close_mic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="关闭麦克风"
        app:layout_constraintBottom_toBottomOf="@+id/voice_status"
        app:layout_constraintTop_toBottomOf="@+id/open_mic"
        app:layout_constraintEnd_toEndOf="@+id/voice_status"/>
</androidx.constraintlayout.widget.ConstraintLayout>